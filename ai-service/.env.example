# Application Settings
ENV=development
DEBUG=true
APP_NAME=ai-service
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Service-to-service Authentication
INTERNAL_API_KEY=dev-internal-secret-key-change-in-production

# CORS Origins (JSON list)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5000","http://localhost:5173"]

# PostgreSQL / pgvector Settings
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mental_health_ai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# AI / LLM Settings (for future phases)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
EMBEDDING_MODEL=all-MiniLM-L6-v2

# NOPE Edge / Ollama Settings
OLLAMA_BASE_URL=http://localhost:11434
NOPE_MODEL=hf.co/nopenet/nope-edge-GGUF:Q4_K_M
NOPE_TIMEOUT_SECONDS=30

# Timeouts (in seconds)
REQUEST_TIMEOUT_SECONDS=30
AI_RESPONSE_TIMEOUT_SECONDS=10
